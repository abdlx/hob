# Allow only the app and its explicitly supplied modified backend into the image.
*
!Dockerfile
!.dockerignore
!LICENSE
!openclaw/
!openclaw/**
!web/
!web/**
!server/
!server/**
!deploy/
!deploy/**
**/.git
**/.git/**
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/.pnpm-store
**/.pnpm-store/**
**/dist
**/dist/**
**/dist-runtime
**/.artifacts
**/.cache
**/.local
**/.openclaw
**/.crabbox
**/coverage
**/*.log
**/.DS_Store
**/*.zip
**/*.sqlite*
**/credentials
**/auth-profiles.json
**/tmp
**/.tmp
openclaw/.worktrees
openclaw/.agents
openclaw/.codex
openclaw/.claude
openclaw/.aws
openclaw/.vscode
