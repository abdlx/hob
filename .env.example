# Standalone/local use: add -f compose.yaml -f compose.standalone.yaml to commands.
# Coolify generates its own values; follow deploy/COOLIFY.md instead.
# Replace both values before starting. Keep the resulting .env private.
HOB_PASSWORD=replace-with-a-long-random-password
HOB_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Set true when accessing the app through your HTTPS reverse proxy.
HOB_SECURE_COOKIES=false
# Set the exact HTTPS origin for public access (e.g. https://hob.example.com).
HOB_PUBLIC_URL=
HOB_BIND_ADDRESS=127.0.0.1
HOB_PORT=3000
# Confirmed browser challenges wait for human intervention. Optional: detect/off.
HOB_CAPTCHA=human
