# The runtime comes from a pinned upstream-source image, never the local reference tree.
*
!Dockerfile
!.dockerignore
!LICENSE
!web/
!web/**
!server/
!server/**
!deploy/
!deploy/**
**/.git
**/.git/**
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/.pnpm-store
**/.pnpm-store/**
**/dist
**/dist/**
**/dist-runtime
**/.artifacts
**/.cache
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.local
**/.openclaw
**/.crabbox
**/coverage
**/*.log
**/.DS_Store
**/*.zip
# Match database artifacts by suffix; .sqlite-*.worker.ts files are build inputs.
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite-journal
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/*.sqlite3-journal
**/credentials
**/auth-profiles.json
**/tmp
**/.tmp
openclaw/.worktrees
openclaw/.agents
openclaw/.codex
openclaw/.claude
openclaw/.aws
openclaw/.vscode
