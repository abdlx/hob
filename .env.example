# Standalone/local use: add -f compose.yaml -f compose.standalone.yaml to commands.
# Coolify generates its own values; follow deploy/COOLIFY.md instead.
# Replace both values before starting. Keep the resulting .env private.
MUSE_PASSWORD=replace-with-a-long-random-password
MUSE_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Set true when accessing the app through your HTTPS reverse proxy.
MUSE_SECURE_COOKIES=false
# Set the exact HTTPS origin for public access (e.g. https://muse.example.com).
MUSE_PUBLIC_URL=
MUSE_BIND_ADDRESS=127.0.0.1
MUSE_PORT=3000
